{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/htt210/awesome-millennium/schema/paper.schema.json",
  "title": "awesome-millennium paper metadata (paper.yaml)",
  "description": "Editor support for paper.yaml. The authoritative validator is tools/catalog.py.",
  "type": "object",
  "required": ["slug", "title", "authors", "date", "tldr", "millennium", "status", "links", "explainer"],
  "additionalProperties": false,
  "$defs": {
    "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "slug": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 60},
    "url": {"type": "string", "pattern": "^https?://\\S+$"},
    "line": {"type": "string", "minLength": 1, "pattern": "^[^|\\n]*$"}
  },
  "properties": {
    "slug": {"$ref": "#/$defs/slug", "description": "Unique id; must equal the directory name."},
    "title": {"$ref": "#/$defs/line"},
    "short_title": {"$ref": "#/$defs/line"},
    "authors": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "date": {"$ref": "#/$defs/date", "description": "Date of the explained version; sets papers/YYYY/MM/."},
    "first_version": {"$ref": "#/$defs/date"},
    "tldr": {"$ref": "#/$defs/line", "description": "One sentence shown in tables."},
    "millennium": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["problem", "relation"],
        "additionalProperties": false,
        "properties": {
          "problem": {"enum": ["p-vs-np", "riemann-hypothesis", "yang-mills", "navier-stokes",
                                "hodge-conjecture", "birch-swinnerton-dyer", "poincare-conjecture"]},
          "relation": {"enum": ["resolves", "partial", "adjacent"]},
          "note": {"$ref": "#/$defs/line"}
        }
      }
    },
    "fields": {"type": "array", "items": {"$ref": "#/$defs/slug"}},
    "tags": {"type": "array", "items": {"$ref": "#/$defs/slug"}},
    "status": {
      "type": "object",
      "required": ["review", "formalization", "community", "as_of"],
      "additionalProperties": false,
      "properties": {
        "review": {"enum": ["preprint", "under-review", "peer-reviewed", "withdrawn"]},
        "formalization": {"enum": ["none", "partial", "complete"]},
        "formalization_system": {"type": "string"},
        "community": {"enum": ["unexamined", "under-examination", "accepted", "disputed", "refuted"]},
        "as_of": {"$ref": "#/$defs/date"},
        "note": {"type": "string"}
      }
    },
    "links": {
      "type": "object",
      "required": ["paper"],
      "properties": {
        "paper": {"$ref": "#/$defs/url"},
        "related": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["label", "url"],
            "properties": {"label": {"$ref": "#/$defs/line"}, "url": {"$ref": "#/$defs/url"}}
          }
        }
      },
      "additionalProperties": {"$ref": "#/$defs/url"}
    },
    "explainer": {
      "type": "object",
      "required": ["added"],
      "additionalProperties": false,
      "properties": {
        "added": {"$ref": "#/$defs/date"},
        "code": {"type": "string"},
        "figures": {"type": "string"},
        "video": {"type": "string", "description": "Path of a rendered video inside the paper directory."},
        "video_url": {"$ref": "#/$defs/url", "description": "Where the video is hosted, if not in the repository."},
        "poster": {"type": "string"},
        "checks": {"type": "array", "items": {"type": "string"},
                   "description": "Commands run from the paper directory by `tools/catalog.py run-checks` (CI)."}
      }
    }
  }
}
